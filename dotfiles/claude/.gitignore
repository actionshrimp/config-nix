# Ignore everything by default
*

# Track config
!.gitignore
!settings.json

# Track custom scripts
!statusline.sh

# Track custom commands, agents, skills
!commands/
!commands/**
!agents/
!agents/**
!skills/
!skills/**

# Work skills live in config-nix-private (this repo is public); they are
# symlinked in here by the privateClaudeSkills activation script.
skills/html-previews
skills/langfuse-cli
skills/linear-cli
skills/stacked-pr-delivery
